# Minecraft server allowlists
MC_OPS=wookey
MC_WHITELIST=wookey
RCON_PASSWORD=replace_with_strong_password

# Bot runtime
MC_HOST=minecraft
MC_PORT=25565
MC_BOT_USERNAME=SilasBot
MC_AUTH=microsoft
MC_AUTH_FLOW=sisu

# Optional runtime data locations. Leave unset for repository-local directories.
MC_SERVER_DATA_DIR=
MC_BACKUP_DIR=
SILAS_AUTH_CACHE_DIR=
SILAS_BOT_DATA_DIR=
SILAS_BUILD_COMMIT=unknown

# Bot behaviour
SILAS_MODE=family
SILAS_ADMIN_USERS=wookey
